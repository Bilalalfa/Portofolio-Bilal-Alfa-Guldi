# CMS Configuration
# Set to 'contentful' or 'sanity'
VITE_CMS_TYPE=

# Contentful Configuration (required if VITE_CMS_TYPE=contentful)
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ACCESS_TOKEN=

# Sanity Configuration (required if VITE_CMS_TYPE=sanity)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=
VITE_SANITY_API_TOKEN=

# Form Submission Endpoint (e.g., Formspree or EmailJS)
VITE_FORM_ENDPOINT=

# Google Gemini AI API Key (Get free key from https://aistudio.google.com/)
VITE_GEMINI_API_KEY=
